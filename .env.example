# ==============================================================================
# Agent Memory Security Center (AMSC) - Local Environment Configuration
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit real production secrets, passwords, or private keys to git.
# ==============================================================================

# --- Application Identity ---
APP_NAME="Agent Memory Security Center"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# --- API Routing ---
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- CORS Settings (comma-separated origins or JSON array) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Security & JWT (Day 2 Authentication Baseline) ---
# In development/test, a secure random key is generated automatically if omitted.
# In production, must be high-entropy random string >= 32 characters provisioned from a secure secret store.
# Generate with: openssl rand -hex 32
# NOTE: Production validation strictly rejects this example placeholder and any string containing 'replace', 'example', 'secret', or 'dev'.
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Authentication Mode ---
# 'in_memory_demo' is permitted ONLY in development and testing environments.
# In production, AUTH_BACKEND must be 'database' and ALLOW_IN_MEMORY_AUTH must be false.
AUTH_BACKEND=in_memory_demo
ALLOW_IN_MEMORY_AUTH=true

# --- Persistence & Ephemeral Cache (Placeholders for M6/M7) ---
# NOTE: In production, DATABASE_URL must point to a real remote PostgreSQL instance with strong credentials.
# Production validation strictly rejects 'amsc_dev_password', 'localhost', and '127.0.0.1'.
DATABASE_URL=postgresql+asyncpg://amsc:amsc_dev_password@localhost:5432/amsc

# NOTE: In production, REDIS_URL must point to a production Redis cluster/service.
# Production validation strictly rejects 'localhost' and '127.0.0.1'.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_FAILURE_POLICY=fail_closed
