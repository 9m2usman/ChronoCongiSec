# ==============================================================================
# Agent Memory Security Center (AMSC) - Local Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# This file contains development-only defaults. Never use it as a production
# deployment configuration and never commit a real .env file or production secret.
# ==============================================================================

# --- Application Identity ---
APP_NAME="Agent Memory Security Center"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# --- API Routing ---
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
ENABLE_DOCS_IN_PRODUCTION=false
PROTECT_DOCS_IN_PRODUCTION=false
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false

# --- CORS Settings (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=INFO

# --- Security & JWT ---
# Leave JWT_SECRET empty for local development/test: the application generates a
# cryptographically random secret at startup. Set a managed high-entropy secret
# explicitly in production (at least 32 characters; never use this file there).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACTIVE_KID=k-current
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Authentication Mode ---
# In-memory demo authentication is for local development and tests only.
# Production requires a configured database-backed authentication repository.
AUTH_BACKEND=in_memory_demo
ALLOW_IN_MEMORY_AUTH=true
AUTH_MAX_CONCURRENT_VERIFICATIONS=8

# --- Login Rate Limiting ---
# The current local application uses the in-memory limiter. Production requires
# a configured persistent Redis-backed limiter and must fail closed if unavailable.
RATE_LIMITER_BACKEND=in_memory
ALLOW_IN_MEMORY_RATE_LIMITER=true
RATE_LIMIT_REDIS_FAILURE_POLICY=fail_closed
LOGIN_RATE_LIMIT_IP_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Empty uses the generated JWT secret in development/test. Production must provide
# a separate high-entropy secret from a secure secret manager.
RATE_LIMIT_HMAC_SECRET=

# --- Persistence & Cache Connection Settings ---
# Used by PostgreSQL migration/database tooling. The current local API factory
# still initializes its demo repositories in memory; DATABASE_URL alone does not
# switch every application service to persistent storage.
DATABASE_URL=postgresql+asyncpg://amsc:amsc_dev_password@localhost:5433/amsc
REDIS_URL=redis://localhost:6379/0
# ==============================================================================
