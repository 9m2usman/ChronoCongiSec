# ==============================================================================
# ChronoCogniSec CrewAI Business Agents - Local Environment Configuration
# ==============================================================================

# --- Execution Mode ---
# 'live' for real LLM model calls; 'test_double' for deterministic test execution
EXECUTION_MODE=live

# --- LLM Provider Configuration ---
# Supported providers: gemini, openai, anthropic, ollama, test_double
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Provider Credentials ---
# Never commit real API keys to version control.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- ChronoCogniSec Platform API Connection ---
CHRONOCONGISEC_API_BASE_URL=http://127.0.0.1:8000/api/v1
CHRONOCONGISEC_TENANT_ID=tenant-a-uuid-001
CHRONOCONGISEC_AUTH_TOKEN=

# --- Enterprise Backend Authentication ---
CHRONOCONGISEC_AUTH_EMAIL=analyst@company-a.com
CHRONOCONGISEC_AUTH_PASSWORD=SecurePassword123!
CHRONOCONGISEC_TENANT_SLUG=company-a

# --- Rate Limiting & Pacing ---
LLM_REQUEST_PACE_SECONDS=4.0
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY_SECONDS=5.0
LLM_RETRY_MAX_DELAY_SECONDS=60.0

# --- Enterprise Branches ---
DEFAULT_BRANCH_ID=branch-ho-001
LAHORE_BRANCH_ID=branch-lhr-002
KARACHI_BRANCH_ID=branch-khi-003
ISLAMABAD_BRANCH_ID=branch-isb-004

# --- Timeouts & Safety Guardrails ---
AGENT_EXECUTION_TIMEOUT_SECONDS=60
MAX_SUBTASK_DELEGATIONS=5
DUAL_CUSTODY_FINANCE_THRESHOLD_USD=300.00
FAIL_CLOSED_ON_SECURITY_ANOMALY=true
